<Project Sdk="Microsoft.NET.Sdk">

  <!-- DB-1c: outside src/, so SQL Server stays out of the Docker image, which publishes only src/OnlyCars.Api. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>OnlyCars.DbCopy.DbCopyTool</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OnlyCars.Infrastructure\OnlyCars.Infrastructure.csproj" />
  </ItemGroup>

</Project>
